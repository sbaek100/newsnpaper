FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# Set non-interactive to avoid timezone prompts during apt
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Setup Python alias
RUN ln -s /usr/bin/python3 /usr/bin/python

COPY translator/requirements.txt /app/
RUN pip3 install --no-cache-dir -r requirements.txt --index-url https://download.pytorch.org/whl/cu121

COPY translator/ /app/translator/
COPY shared/ /app/shared/

CMD ["python", "-m", "translator.main"]
