# 비민감 설정만 둔다. 민감값은 secrets/ 아래 파일로 (PRD-02 §3)
COMPOSE_PROJECT_NAME=secubrief

# 포트
PROXY_PORT=80
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 수집 (PRD-03 FR-27, FR-38)
BATCH_TIMES=09:00,21:00
BATCH_LIMIT_NEWS=100
BATCH_LIMIT_PAPERS=30

# 번역 (PRD-03 §8.1)
TRANSLATOR_MODEL=Qwen/Qwen2.5-7B-Instruct
TRANSLATOR_DTYPE=fp16
TRANSLATOR_WORKERS=4
TRANSLATOR_GPUS_PER_WORKER=2

# 시크릿 파일 경로 (PRD-02 FR-3)
DB_PASSWORD_FILE=/run/secrets/db_password
JWT_SECRET_FILE=/run/secrets/jwt_secret
NAVER_CLIENT_SECRET_FILE=/run/secrets/naver_client_secret
